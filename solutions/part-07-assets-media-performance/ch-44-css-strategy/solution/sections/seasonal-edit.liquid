{{ 'section-seasonal-edit.css' | asset_url | stylesheet_tag }}
<section id="SeasonalEdit-{{ section.id }}" class="seasonal-edit" style="--seasonal-edit-bg: {{ section.settings.background }}; --seasonal-edit-gap: {{ section.settings.gap }}px; --seasonal-edit-align: {{ section.settings.alignment }};">
  <div class="seasonal-edit__media"></div><div class="seasonal-edit__content"><h2>{{ section.settings.heading | escape }}</h2></div>
</section>
{% schema %}{"name":"Seasonal edit","settings":[{"type":"color","id":"background","label":"Background","default":"#f4f1eb"},{"type":"range","id":"gap","label":"Gap","min":8,"max":64,"step":4,"unit":"px","default":24},{"type":"select","id":"alignment","label":"Alignment","options":[{"value":"start","label":"Start"},{"value":"center","label":"Center"}],"default":"start"},{"type":"text","id":"heading","label":"Heading","default":"Seasonal edit"}],"presets":[{"name":"Seasonal edit"}]}{% endschema %}
