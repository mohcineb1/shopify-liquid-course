<!-- Liquid July ’26 developer preview only. Do not ship to a stable theme. -->
{% block 'preview-frame', tag: 'main', class: 'collection-preview page-width' %}
  <header class="collection-preview__header"><h1>{{ collection.title | escape }}</h1><label for="collection-preview-sort">Sort</label><select id="collection-preview-sort" data-collection-preview-sort><option value="">Featured</option><option value="price-ascending">Price, low to high</option><option value="price-descending">Price, high to low</option></select></header>
  <p data-collection-preview-status aria-live="polite"></p>
  {% partial 'product-grid' %}<div class="collection-preview__results" data-collection-preview-results aria-busy="false">{% for product in collection.products %}<article><h2>{{ product.title | escape }}</h2></article>{% endfor %}</div>{% endpartial %}
{% endblock %}
<script type="module" src="{{ 'collection-preview.js' | asset_url }}"></script>
