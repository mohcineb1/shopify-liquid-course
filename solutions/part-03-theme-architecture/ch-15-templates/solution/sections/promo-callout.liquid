{{ 'section-promo-callout.css' | asset_url | stylesheet_tag }}
<section class="promo-callout"><h2>{{ section.settings.heading | default: 'sections.promo_callout.default_heading' | t }}</h2><p>{{ section.settings.message | escape }}</p></section>
{% schema %}{ "name": "Promo callout", "settings": [{ "type": "text", "id": "heading", "label": "Heading" }, { "type": "textarea", "id": "message", "label": "Message" }] }{% endschema %}
