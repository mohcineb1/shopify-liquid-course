{{ 'section-debug-spotlight.css' | asset_url | stylesheet_tag }}
<section class="debug-spotlight" aria-labelledby="DebugSpotlightHeading-{{ section.id }}">
  <h2 id="DebugSpotlightHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  {% if section.settings.collection != blank %}
    {% for product in section.settings.collection.products limit: 4 %}
      {% if forloop.first %}<ol class="debug-spotlight__list">{% endif %}
      <li class="debug-spotlight__item">{{ product.title | escape }}</li>
      {% if forloop.last %}</ol>{% endif %}
    {% else %}<p>This selected collection has no products yet.</p>{% endfor %}
    {% if settings.enable_theme_debug %}{% render 'debug', label: 'Selected collection', title: section.settings.collection.title, count: section.settings.collection.products_count %}{% endif %}
  {% else %}<p>Select a collection to configure this spotlight.</p>{% endif %}
</section>
{% schema %}{ "name": "Debug spotlight", "tag": "section", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Collection spotlight" }, { "type": "collection", "id": "collection", "label": "Collection" }], "presets": [{ "name": "Debug spotlight" }] }{% endschema %}
