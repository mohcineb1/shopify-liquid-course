{{ 'section-drop-preview.css' | asset_url | stylesheet_tag }}
<section class="drop-preview" aria-labelledby="DropPreviewHeading-{{ section.id }}">
  <h2 id="DropPreviewHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  {% for product in collection.products limit: 4 %}
    {% if forloop.first %}<ol class="drop-preview__list">{% endif %}
    <li class="drop-preview__card">
      <h3>{{ product.title | escape }}</h3>
      {% if product.featured_image %}{{ product.featured_image | image_url: width: 320 | image_tag: alt: product.title }}{% endif %}
      {% if product.variants.size > 0 %}<ol class="drop-preview__variants">{% for variant in product.variants limit: 2 %}<li>{{ variant.title | escape }}</li>{% endfor %}</ol>{% endif %}
      <script type="application/json" data-drop-preview>{% render 'drop-preview-data', preview_product: product %}</script>
    </li>
    {% if forloop.last %}</ol>{% endif %}
  {% else %}<p>No products are available in this collection.</p>{% endfor %}
</section>
{% schema %}{ "name": "Drop preview", "tag": "section", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Collection preview" }], "presets": [{ "name": "Drop preview" }] }{% endschema %}
