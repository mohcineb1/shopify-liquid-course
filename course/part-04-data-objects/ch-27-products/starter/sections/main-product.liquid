{{ 'main-product.css' | asset_url | stylesheet_tag }}
<section class="main-product">
  <div class="page-width">
    <p>{{ product.vendor }}</p>
    <h1>{{ product.title }}</h1>
    <p class="main-product__price">{{ product.price | money }}</p>
    {% if product.available %}<button type="button">Add to cart</button>{% endif %}
    {% render 'product-media', product: product %}
    <form method="post" action="{{ routes.cart_add_url }}">
      <select name="id">{% for variant in product.variants %}<option value="{{ variant.id }}">{{ variant.title }}</option>{% endfor %}</select>
      <input type="number" name="quantity" value="1">
      <button type="submit">Add to cart</button>
    </form>
  </div>
</section>
{% schema %}
{ "name": "Main product", "settings": [] }
{% endschema %}
