<section class="main-product"><h1>{{ product.title }}</h1>{% form 'product', product %}<select name="id">{% for variant in product.variants %}<option value="{{ variant.id }}">{{ variant.title }}</option>{% endfor %}</select><button>Add to cart</button>{% endform %}</section>
{% schema %}{"name":"Main product","settings":[]}{% endschema %}
