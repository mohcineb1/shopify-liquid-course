{{ 'purchase-test-panel.css' | asset_url | stylesheet_tag }}

<section class="purchase-test-panel">
  <img src="{{ product.featured_image | image_url: width: 640 }}" alt="{{ product.title }}">
  <h1>{{ product.title }}</h1>
  <p>{{ product.price | money }}</p>
  <form method="post" action="/cart/add">
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
    <button type="submit">Add to cart</button>
  </form>
</section>

{% schema %}
{
  "name": "Purchase test panel",
  "settings": [
    { "type": "checkbox", "id": "show_media", "label": "Show media", "default": true }
  ]
}
{% endschema %}
