{{ 'section-collection-highlight.css' | asset_url | stylesheet_tag }}
<section class="collection-highlight" aria-labelledby="CollectionHighlightHeading-{{ section.id }}">
  <h2 id="CollectionHighlightHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  {%- comment -%} Distinguish the missing setting, selected-empty, and bounded card-preview states here. {%- endcomment -%}
</section>
{% schema %}
{ "name": "Collection highlight", "tag": "section", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Collection highlight" }, { "type": "collection", "id": "collection", "label": "Collection" }], "presets": [{ "name": "Collection highlight" }] }
{% endschema %}
